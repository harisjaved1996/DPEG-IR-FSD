<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Raised_Pct__c</fullName>
    <description>Proportion of the Target Raise that has been raised to date.</description>
    <formula>IF(Target_Raise__c &gt; 0, Amount_Raised__c / Target_Raise__c, 0)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <inlineHelpText>Automatically calculated: Amount Raised divided by Target Raise.</inlineHelpText>
    <label>Raised %</label>
    <precision>18</precision>
    <required>false</required>
    <scale>2</scale>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Percent</type>
</CustomField>
